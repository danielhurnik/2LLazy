// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NOTE: `JobPosting.source` is a plain String, not an enum, on purpose.
// Job boards live in the runtime board registry (src/lib/scrapers), keyed by an
// uppercase id such as "REMOTIVE" or "ADZUNA". Adding a board must never require
// a database migration.

enum ApplicationStatus {
  PENDING
  APPLIED
  REJECTED
  INTERVIEW
  OFFER
  FAILED
}

// ── NextAuth models ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // hashed — only set for credentials accounts
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  // App data
  applications   Application[]
  coverLetters   CoverLetter[]
  calendarEvents CalendarEvent[]
  cvDocuments    CvDocument[]
  userProfile    UserProfile?
  favourites     UserFavourite[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ── Per-user favourites (replaces `favourited` field on JobPosting) ────────────

model UserFavourite {
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  // The composite PK already covers lookups by userId; purging stale postings
  // cascades by jobId, which without this index means a sequential scan per row.
  @@index([jobId])
}

// ── App models ─────────────────────────────────────────────────────────────────

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  name                String
  email               String
  phone               String?
  cvPath              String?
  linkedInUrl         String?
  githubUrl           String?
  coverLetterLanguage String   @default("English")
  googleCalendarSync  Boolean  @default(false)
  // Scraping preferences — drive board selection and result filtering.
  country             String? // ISO 3166-1 alpha-2, uppercase (e.g. "CZ")
  preferredWorkType   String?
  remoteOnly          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobPosting {
  id          String    @id @default(cuid())
  title       String
  company     String
  location    String?
  country     String? // ISO 3166-1 alpha-2, uppercase; null = unknown / worldwide
  description String    @db.Text
  sourceUrl   String    @unique
  source      String // uppercase board id from the scraper registry, e.g. "REMOTIVE"
  salary      String?
  workType    String?
  postedAt    DateTime?
  scrapedAt   DateTime  @default(now())
  firstSeenAt DateTime  @default(now())

  applications Application[]
  coverLetters CoverLetter[]
  favouritedBy UserFavourite[]

  @@index([source])
  @@index([country])
  // The search path filters by country and freshness together.
  @@index([country, scrapedAt])
  @@index([scrapedAt])
  @@index([firstSeenAt])
  // Ranking is lexical now that embeddings are gone. Two indexes back it and are
  // NOT expressible in Prisma schema — they are created as raw SQL in
  // prisma/migrations/20260823010000_remove_ai_add_country/migration.sql:
  //   * "JobPosting_fulltext_idx"   — GIN over to_tsvector('simple', title || company || description)
  //   * "JobPosting_title_trgm_idx" — GIN gin_trgm_ops on title (fuzzy matching)
  // `prisma migrate dev` will propose `DROP INDEX "JobPosting_title_trgm_idx"`
  // because it cannot model an operator class. Delete that line from any
  // generated migration — the index is intentional.
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  jobId         String
  job           JobPosting        @relation(fields: [jobId], references: [id])
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        ApplicationStatus @default(PENDING)
  appliedAt     DateTime?
  errorMessage  String?           @db.Text
  notes         String?           @db.Text
  coverLetterId String?
  coverLetter   CoverLetter?      @relation(fields: [coverLetterId], references: [id])
  interview     Interview?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId])
  @@index([jobId])
}

model CoverLetter {
  id           String        @id @default(cuid())
  userId       String
  jobId        String
  job          JobPosting    @relation(fields: [jobId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String        @db.Text
  // Letters are composed from a template + CV + job facts — nothing is generated
  // by a model any more. Renamed from `generatedByAI`.
  generatedFromTemplate Boolean @default(false)
  createdAt    DateTime      @default(now())
  applications Application[]

  @@index([userId])
  @@index([jobId])
}

model Interview {
  id                    String      @id @default(cuid())
  applicationId         String      @unique
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt           DateTime
  durationMinutes       Int         @default(60)
  timezone              String      @default("UTC")
  notes                 String?     @db.Text
  googleCalendarEventId String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model CalendarEvent {
  id                    String   @id @default(cuid())
  userId                String
  title                 String
  scheduledAt           DateTime
  durationMinutes       Int      @default(60)
  notes                 String?  @db.Text
  googleCalendarEventId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CvDocument {
  id           String   @id @default(cuid())
  userId       String
  originalName String
  data         Bytes
  size         Int
  uploadedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
